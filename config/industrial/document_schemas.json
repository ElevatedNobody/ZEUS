        {"name": "purchase_order", "type": "reference", "required": false, "patterns": ["(?i)\\b(?:purchase\\s*order|p\\.?o\\.?)\\s*(?:no\\.?|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-]{3,25})"]},

      "expected_fields": ["equipment_id", "equipment_type", "service", "design_pressure", "design_temperature", "operating_pressure", "operating_temperature", "capacity", "material_of_construction", "corrosion_allowance", "code_of_construction", "nozzle_schedule", "revision", "source_page"],
      "extraction_fields": [
        {"name": "equipment_id", "type": "tag", "required": false, "patterns": ["(?i)\\b(?:tag|item)\\s*(?:no\\.?|number|#)?\\s*[:\\-]\\s*\\|?\\s*([A-Z]{1,4}-?\\d{2,5}[A-Z]?)"]},
        {"name": "design_pressure", "type": "quantity", "required": false, "patterns": ["(?i)\\bdesign\\s*pressure\\s*[:\\-]?\\s*([0-9.]+\\s*(?:bar\\s*g?|kg/cm2|kpa|mpa|psi(?:g)?))"]},
        {"name": "design_temperature", "type": "quantity", "required": false, "patterns": ["(?i)\\bdesign\\s*temp(?:erature)?\\s*[:\\-]?\\s*([\\-0-9.]+\\s*(?:deg\\s*c|°c|c|f))"]},
        {"name": "operating_pressure", "type": "quantity", "required": false, "patterns": ["(?i)\\boperating\\s*pressure\\s*[:\\-]?\\s*([0-9.]+\\s*(?:bar\\s*g?|kg/cm2|kpa|mpa|psi(?:g)?))"]},
        {"name": "operating_temperature", "type": "quantity", "required": false, "patterns": ["(?i)\\boperating\\s*temp(?:erature)?\\s*[:\\-]?\\s*([\\-0-9.]+\\s*(?:deg\\s*c|°c|c|f))"]},
        {"name": "capacity", "type": "quantity", "required": false, "patterns": ["(?i)\\b(?:capacity|rated\\s*flow|duty)\\s*[:\\-]?\\s*([0-9.]+\\s*[A-Za-z/³^0-9]{1,12})"]},
        {"name": "material_of_construction", "type": "text", "required": false, "patterns": ["(?i)\\b(?:material(?:\\s*of\\s*construction)?|moc)\\s*[:\\-]?\\s*([A-Za-z0-9][A-Za-z0-9 .,/\\-]{2,60})"]},
        {"name": "corrosion_allowance", "type": "quantity", "required": false, "patterns": ["(?i)\\bcorrosion\\s*allowance\\s*[:\\-]?\\s*([0-9.]+\\s*(?:mm|in(?:ch)?))"]},
        {"name": "code_of_construction", "type": "text", "required": false, "patterns": ["(?i)\\b(?:code|designed\\s*to|as\\s*per)\\s*[:\\-]?\\s*(ASME[^,;\\n]{0,20}|API\\s*\\d{3}|IS\\s*\\d{3,5}|IBR)"]}
      ],
      "validation": [
        {"field": "design_pressure", "rule": "has_unit", "detail": "Pressure without a unit is unusable - flag rather than assume bar."},
        {"field": "design_temperature", "rule": "has_unit", "detail": "Temperature without a unit is unusable - flag rather than assume Celsius."},
        {"field": "operating_pressure", "rule": "not_greater_than", "compare_to": "design_pressure", "detail": "Operating above design is a finding, not a transcription error - flag it."}
      ]
    },

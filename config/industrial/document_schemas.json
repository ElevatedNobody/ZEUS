        {"name": "equipment_id", "type": "tag", "required": false, "patterns": ["(?i)\\b(?:equipment|item|tag)\\s*[:\\-]?\\s*([A-Z]{1,4}-?\\d{2,5}[A-Z]?)"]},
        {"name": "test_type", "type": "enum", "required": false, "enum": ["hydrotest", "pneumatic test", "performance test", "material test", "vibration test", "insulation resistance", "functional test", "acceptance test"]},
        {"name": "test_date", "type": "date", "required": true, "fallback": "doc_date"},
        {"name": "test_conditions", "type": "text", "required": false, "patterns": ["(?i)\\btest\\s*(?:pressure|conditions?|medium|duration)\\s*[:\\-]?\\s*(.{2,120})"]},
        {"name": "acceptance_criteria", "type": "text", "required": false, "patterns": ["(?i)\\bacceptance\\s*criteri(?:a|on)\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "measured_values", "type": "table", "required": false, "source": "tables"},
        {"name": "witnessed_by", "type": "person", "required": false, "patterns": ["(?i)\\bwitness(?:ed)?\\s*(?:by)?\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"]},
        {"name": "conclusion", "type": "enum", "required": false, "enum": ["pass", "fail", "accepted", "rejected", "conditional"]}

{
  "version": "1.0.0",
  "description": "Structured schemas for common industrial documents. Each schema declares document metadata, expected fields, extraction patterns, validation rules and the evidence/source fields that must accompany every extracted value. Used by industrial/schemas.py for classification, extraction and validation - entirely local, no network.",
  "common": {
    "document_metadata": [
      "document_id", "filename", "source_path", "document_type", "document_class",
      "title", "revision", "doc_date", "author", "department", "plant_unit",
      "confidentiality", "page_count", "file_hash", "extraction_method", "ingested_at"
    ],
    "evidence_fields": [
      "source_page", "source_section", "source_heading", "source_location",
      "extraction_method", "ocr_confidence", "evidence_chunk_ids", "claim_type"
    ],
    "generic_patterns": {
      "revision": ["(?i)\\brev(?:ision)?\\.?\\s*[:#-]?\\s*([A-Z0-9][A-Z0-9.\\-]{0,7})\\b"],
      "doc_date": [
        "(?i)\\b(?:date|dated|issued\\s*on)\\s*[:\\-]?\\s*(\\d{1,2}[-/.]\\d{1,2}[-/.]\\d{2,4})",
        "(?i)\\b(?:date|dated)\\s*[:\\-]?\\s*(\\d{4}-\\d{2}-\\d{2})",
        "(?i)\\b(\\d{1,2}\\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{4})"
      ],
      "document_number": ["(?i)\\b(?:doc(?:ument)?|report)\\s*(?:no\\.?|number|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-_.]{3,30})"],
      "equipment_id": ["\\b([A-Z]{1,4}-?\\d{2,5}[A-Z]?)\\b"],
      "plant_unit": ["(?i)\\b(?:unit|plant|area|block)\\s*[:\\-]?\\s*([A-Z0-9][A-Za-z0-9 &/\\-]{1,40})"],
      "department": ["(?i)\\b(?:department|dept\\.?|section)\\s*[:\\-]?\\s*([A-Za-z][A-Za-z &/\\-]{2,40})"],
      "confidentiality": ["(?i)\\b(public|internal(?:\\s+use\\s+only)?|confidential|restricted|secret)\\b"],
      "author": ["(?i)\\b(?:prepared\\s*by|author|inspector|engineer|written\\s*by|reported\\s*by)\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"],
      "approved_by": ["(?i)\\b(?:approved\\s*by|authorised\\s*by|authorized\\s*by|reviewed\\s*by)\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"]
    }
  },
  "schemas": {
    "inspection_report": {
      "name": "Inspection Report",
      "description": "Record of an in-service or shutdown inspection of an equipment item, with measurements, defects and recommendations.",
      "classification": {
        "keywords": ["inspection report", "inspection", "inspected by", "thickness", "ut reading", "cml", "tml", "visual inspection", "ndt", "corrosion", "next inspection due", "fitness for service"],
        "filename_hints": ["inspection", "insp", "ndt", "ut", "rbi", "thickness"],
        "min_score": 2
      },
      "expected_fields": ["equipment_id", "equipment_type", "inspection_date", "inspector", "location", "operating_condition", "measurements", "defects", "observations", "images", "severity", "recommendation", "required_action", "supporting_sop", "revision", "source_page"],
      "extraction_fields": [
        {"name": "equipment_id", "type": "tag", "required": true, "patterns": ["(?i)\\b(?:equipment|equip\\.?|asset|tag)\\s*(?:id|no\\.?|number|#)?\\s*[:\\-]\\s*\\|?\\s*([A-Z]{1,4}-?\\d{2,5}[A-Z]?)", "\\b([A-Z]{1,4}-\\d{3,5}[A-Z]?)\\b"]},
        {"name": "equipment_type", "type": "taxonomy_term", "required": false, "taxonomy_categories": ["rotating_equipment", "static_equipment", "piping_valves"]},
        {"name": "inspection_date", "type": "date", "required": true, "patterns": ["(?i)\\b(?:inspection|inspected|survey)\\s*(?:date|on)\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"], "fallback": "doc_date"},
        {"name": "inspector", "type": "person", "required": true, "patterns": ["(?i)\\b(?:inspector|inspected\\s*by)\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"], "fallback": "author"},
        {"name": "location", "type": "text", "required": false, "patterns": ["(?i)\\blocation\\s*[:\\-]\\s*([A-Za-z0-9][A-Za-z0-9 ,/&\\-]{2,60})", "(?i)\\b(?:area|unit)\\s*[:\\-]\\s*([A-Za-z0-9][A-Za-z0-9 ,/&\\-]{2,60})"]},
        {"name": "operating_condition", "type": "text", "required": false, "patterns": ["(?i)\\b(?:operating\\s*condition|service\\s*condition|condition\\s*at\\s*inspection)\\s*[:\\-]?\\s*(.{3,120})"]},
        {"name": "measurements", "type": "table", "required": false, "source": "tables", "notes": "Thickness/CML tables are captured as table elements with their page number preserved."},
        {"name": "defects", "type": "list", "required": false, "patterns": ["(?i)\\b(?:defect|damage|flaw|crack|pitting|thinning|leak|erosion|corrosion)\\b[^.\\n]{0,160}"]},
        {"name": "observations", "type": "list", "required": false, "patterns": ["(?i)\\b(?:observation|observed|noted|finding)s?\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "images", "type": "asset_refs", "required": false, "source": "assets"},
        {"name": "severity", "type": "enum", "required": false, "enum": ["low", "medium", "high", "critical", "minor", "major"], "patterns": ["(?i)\\bseverity\\s*[:\\-]?\\s*(low|medium|high|critical|minor|major)"]},
        {"name": "recommendation", "type": "text", "required": true, "patterns": ["(?i)\\b(?:recommendation|recommended|suggest(?:ed)?)\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "required_action", "type": "text", "required": false, "patterns": ["(?i)\\b(?:action\\s*required|required\\s*action|corrective\\s*action|action\\s*plan)\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "supporting_sop", "type": "reference", "required": false, "patterns": ["(?i)\\b(?:sop|procedure|as\\s*per)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-_.]{3,30})"]},
        {"name": "next_inspection_due", "type": "date", "required": false, "patterns": ["(?i)\\bnext\\s*(?:inspection|due)\\s*(?:date)?\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"]}
      ],
      "validation": [
        {"field": "equipment_id", "rule": "required", "detail": "An inspection finding without an equipment tag cannot be attributed to an asset."},
        {"field": "inspection_date", "rule": "date_parseable", "detail": "Date must parse to a real calendar date."},
        {"field": "severity", "rule": "in_enum", "detail": "Severity must be one of the declared values."},
        {"field": "measurements", "rule": "numeric_units", "detail": "Thickness values should carry a unit (mm/inch) - flag if absent."},
        {"field": "recommendation", "rule": "requires_evidence", "detail": "Every recommendation must cite at least one evidence chunk."}
      ]
    },
    "maintenance_report": {
      "name": "Maintenance Report",
      "description": "Record of maintenance work executed on an asset, including cause, work done, parts and return-to-service status.",
      "classification": {
        "keywords": ["maintenance report", "job completed", "work done", "spares used", "breakdown", "overhaul", "repair", "restored to service", "downtime"],
        "filename_hints": ["maintenance", "maint", "repair", "overhaul", "job"],
        "min_score": 2
      },
      "expected_fields": ["equipment_id", "work_order_no", "maintenance_type", "date_started", "date_completed", "technician", "reported_problem", "work_performed", "parts_used", "downtime_hours", "root_cause", "status", "revision", "source_page"],
      "extraction_fields": [
        {"name": "equipment_id", "type": "tag", "required": true, "patterns": ["(?i)\\b(?:equipment|asset|tag)\\s*(?:id|no\\.?|#)?\\s*[:\\-]\\s*\\|?\\s*([A-Z]{1,4}-?\\d{2,5}[A-Z]?)"]},
        {"name": "work_order_no", "type": "reference", "required": false, "patterns": ["(?i)\\b(?:work\\s*order|w\\.?o\\.?|job)\\s*(?:no\\.?|number|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-]{3,20})"]},
        {"name": "maintenance_type", "type": "enum", "required": false, "enum": ["preventive", "predictive", "corrective", "breakdown", "shutdown", "modification"], "patterns": ["(?i)\\b(preventive|predictive|corrective|breakdown|shutdown|modification)\\s*maintenance"]},
        {"name": "date_started", "type": "date", "required": false, "patterns": ["(?i)\\b(?:start(?:ed)?\\s*date|date\\s*started)\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"]},
        {"name": "date_completed", "type": "date", "required": false, "patterns": ["(?i)\\b(?:complet(?:ed|ion)\\s*date|date\\s*completed)\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"]},
        {"name": "technician", "type": "person", "required": false, "patterns": ["(?i)\\b(?:technician|executed\\s*by|carried\\s*out\\s*by|fitter)\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"], "fallback": "author"},
        {"name": "reported_problem", "type": "text", "required": false, "patterns": ["(?i)\\b(?:reported\\s*problem|complaint|symptom|problem\\s*description)\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "work_performed", "type": "text", "required": true, "patterns": ["(?i)\\b(?:work\\s*(?:done|performed|carried\\s*out)|job\\s*description)\\s*[:\\-]?\\s*(.{3,500})"]},
        {"name": "parts_used", "type": "list", "required": false, "patterns": ["(?i)\\b(?:spares?|parts?)\\s*(?:used|replaced|consumed)\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "downtime_hours", "type": "number", "required": false, "patterns": ["(?i)\\bdowntime\\s*[:\\-]?\\s*([0-9.]{1,6})\\s*(?:hrs?|hours?)"]},
        {"name": "root_cause", "type": "text", "required": false, "patterns": ["(?i)\\broot\\s*cause\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "status", "type": "enum", "required": false, "enum": ["completed", "pending", "in progress", "deferred", "cancelled"], "patterns": ["(?i)\\bstatus\\s*[:\\-]?\\s*(completed|pending|in\\s*progress|deferred|cancelled)"]}
      ],
      "validation": [
        {"field": "equipment_id", "rule": "required", "detail": "Maintenance history must be attributable to an asset."},
        {"field": "work_performed", "rule": "required", "detail": "A maintenance record with no work description has no value in history."},
        {"field": "date_completed", "rule": "date_after", "compare_to": "date_started", "detail": "Completion cannot precede start."},
        {"field": "downtime_hours", "rule": "non_negative", "detail": "Downtime must be zero or positive."}
      ]
    },
    "equipment_history": {
      "name": "Equipment History",
      "description": "Consolidated life history of one asset: installation, modifications, failures, inspections and interventions.",
      "classification": {
        "keywords": ["equipment history", "asset history", "history card", "installation date", "service history", "failure history", "life cycle"],
        "filename_hints": ["history", "asset", "lifecycle", "equipment_card"],
        "min_score": 2
      },
      "expected_fields": ["equipment_id", "equipment_type", "manufacturer", "model", "serial_number", "installation_date", "design_conditions", "service_fluid", "events", "failures", "modifications", "current_status", "source_page"],
      "extraction_fields": [
        {"name": "equipment_id", "type": "tag", "required": true, "patterns": ["(?i)\\b(?:equipment|asset|tag)\\s*(?:id|no\\.?|#)?\\s*[:\\-]\\s*\\|?\\s*([A-Z]{1,4}-?\\d{2,5}[A-Z]?)"]},
        {"name": "manufacturer", "type": "text", "required": false, "patterns": ["(?i)\\b(?:manufacturer|make|oem|vendor)\\s*[:\\-]?\\s*([A-Za-z0-9][A-Za-z0-9 .&\\-]{2,50})"]},
        {"name": "model", "type": "text", "required": false, "patterns": ["(?i)\\b(?:model|type\\s*no\\.?)\\s*[:\\-]?\\s*([A-Za-z0-9][A-Za-z0-9 ./\\-]{1,40})"]},
        {"name": "serial_number", "type": "text", "required": false, "patterns": ["(?i)\\b(?:serial|sr\\.?\\s*no\\.?|s/n)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-]{2,30})"]},
        {"name": "installation_date", "type": "date", "required": false, "patterns": ["(?i)\\b(?:installed|installation|commissioned)\\s*(?:on|date)?\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{4,20})"]},
        {"name": "design_conditions", "type": "text", "required": false, "patterns": ["(?i)\\bdesign\\s*(?:pressure|temperature|conditions)\\s*[:\\-]?\\s*(.{3,120})"]},
        {"name": "service_fluid", "type": "text", "required": false, "patterns": ["(?i)\\b(?:service|fluid|medium)\\s*[:\\-]?\\s*([A-Za-z][A-Za-z0-9 ,/\\-]{2,60})"]},
        {"name": "events", "type": "list", "required": false, "source": "tables"},
        {"name": "current_status", "type": "enum", "required": false, "enum": ["in service", "standby", "out of service", "decommissioned", "under maintenance"]}
      ],
      "validation": [
        {"field": "equipment_id", "rule": "required", "detail": "History must belong to a single identified asset."},
        {"field": "installation_date", "rule": "date_parseable", "detail": "Installation date must be a real date if present."},
        {"field": "events", "rule": "chronological", "detail": "Event dates should be non-decreasing when a sequence is present."}
      ]
    },
    "sop": {
      "name": "Standard Operating Procedure",
      "description": "Approved step-by-step procedure for an operating, maintenance or safety task.",
      "classification": {
        "keywords": ["standard operating procedure", "sop", "procedure", "purpose", "scope", "responsibility", "step 1", "precautions", "work instruction"],
        "filename_hints": ["sop", "procedure", "wi", "instruction"],
        "min_score": 2
      },
      "expected_fields": ["sop_number", "title", "purpose", "scope", "responsibility", "prerequisites", "ppe_required", "steps", "precautions", "references", "revision", "effective_date", "approved_by", "source_page"],
      "extraction_fields": [
        {"name": "sop_number", "type": "reference", "required": true, "patterns": ["(?i)\\b(?:sop|procedure|doc)\\s*(?:no\\.?|number|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-_.]{3,30})"], "fallback": "document_number"},
        {"name": "purpose", "type": "text", "required": false, "patterns": ["(?i)\\b(?:purpose|objective)\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "scope", "type": "text", "required": false, "patterns": ["(?i)\\bscope\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "responsibility", "type": "text", "required": false, "patterns": ["(?i)\\bresponsibilit(?:y|ies)\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "ppe_required", "type": "list", "required": false, "patterns": ["(?i)\\b(?:ppe|personal\\s*protective\\s*equipment)\\s*[:\\-]?\\s*(.{3,200})"]},
        {"name": "steps", "type": "ordered_list", "required": true, "source": "numbered_paragraphs"},
        {"name": "precautions", "type": "list", "required": false, "patterns": ["(?i)\\b(?:precaution|caution|warning|safety\\s*note)s?\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "references", "type": "list", "required": false, "patterns": ["(?i)\\b(?:reference|refer\\s*to|as\\s*per)\\s*[:\\-]?\\s*(.{3,200})"]},
        {"name": "effective_date", "type": "date", "required": false, "patterns": ["(?i)\\b(?:effective|issue)\\s*date\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"], "fallback": "doc_date"},
        {"name": "approved_by", "type": "person", "required": false, "patterns": ["(?i)\\bapproved\\s*by\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"]}
      ],
      "validation": [
        {"field": "revision", "rule": "required", "detail": "An SOP without a revision cannot be cited safely - procedures change."},
        {"field": "steps", "rule": "non_empty", "detail": "A procedure must contain at least one step."},
        {"field": "approved_by", "rule": "present_or_flag", "detail": "Unapproved SOPs must be flagged, never cited as authoritative."}
      ]
    },
    "engineering_drawing": {
      "name": "Engineering Drawing / P&ID",
      "description": "Drawing sheet - P&ID, PFD, isometric, GA or datasheet drawing - identified by title block and drawing number.",
      "classification": {
        "keywords": ["p&id", "piping and instrumentation", "drawing no", "drg no", "sheet", "scale", "title block", "isometric", "general arrangement", "process flow diagram", "revision cloud", "as built"],
        "filename_hints": ["pid", "p&id", "drawing", "drg", "iso", "ga", "pfd", "layout"],
        "min_score": 2
      },
      "expected_fields": ["drawing_number", "drawing_title", "sheet_number", "revision", "scale", "drawn_by", "checked_by", "approved_by", "plant_unit", "equipment_tags", "line_numbers", "instrument_tags", "legend_notes", "as_built_status", "source_page"],
      "extraction_fields": [
        {"name": "drawing_number", "type": "reference", "required": true, "patterns": ["(?i)\\b(?:drawing|drg|dwg)\\s*(?:no\\.?|number|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-_.]{3,30})"]},
        {"name": "drawing_title", "type": "text", "required": false, "patterns": ["(?i)\\btitle\\s*[:\\-]?\\s*(.{3,120})"]},
        {"name": "sheet_number", "type": "text", "required": false, "patterns": ["(?i)\\bsheet\\s*(?:no\\.?)?\\s*[:\\-]?\\s*(\\d{1,3}\\s*(?:of\\s*\\d{1,3})?)"]},
        {"name": "scale", "type": "text", "required": false, "patterns": ["(?i)\\bscale\\s*[:\\-]?\\s*([0-9A-Za-z:./ ]{1,20})"]},
        {"name": "equipment_tags", "type": "tag_list", "required": false, "source": "taxonomy_tag_patterns"},
        {"name": "line_numbers", "type": "tag_list", "required": false, "patterns": ["\\b\\d{1,2}\"?-[A-Z]{1,4}-\\d{3,6}-[A-Z0-9]{2,8}\\b"]},
        {"name": "instrument_tags", "type": "tag_list", "required": false, "patterns": ["\\b(?:PI|PT|PC|TI|TT|TC|FI|FT|FC|LI|LT|LC|AI|AT|XV|PSV|FCV|LCV|PCV|TCV)-?\\d{2,5}[A-Z]?\\b"]},
        {"name": "as_built_status", "type": "enum", "required": false, "enum": ["as built", "for construction", "for approval", "for information", "preliminary"]}
      ],
      "validation": [
        {"field": "drawing_number", "rule": "required", "detail": "A drawing must be citable by number."},
        {"field": "revision", "rule": "required", "detail": "Drawings are only meaningful with their revision - superseded revisions must never be cited as current."},
        {"field": "equipment_tags", "rule": "taxonomy_known", "detail": "Tags should match known equipment tag patterns; unknown patterns are flagged, not invented."}
      ],
      "notes": "Drawings are usually scanned or vector-only: the pipeline routes them through layout analysis and OCR, and marks pages that need the vision model for symbol-level understanding."
    },
    "shift_log": {
      "name": "Shift Log",
      "description": "Chronological operating log for one shift, with plant conditions, abnormalities, actions and handover notes.",
      "classification": {
        "keywords": ["shift log", "log book", "handover", "shift in charge", "a shift", "b shift", "c shift", "general shift", "hrs", "operator log"],
        "filename_hints": ["shiftlog", "log", "handover", "logbook"],
        "min_score": 2
      },
      "expected_fields": ["log_date", "shift", "unit", "shift_incharge", "operators", "entries", "abnormal_conditions", "equipment_status_changes", "handover_notes", "source_page"],
      "extraction_fields": [
        {"name": "log_date", "type": "date", "required": true, "patterns": ["(?i)\\b(?:date|shift\\s*date)\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"], "fallback": "doc_date"},
        {"name": "shift", "type": "enum", "required": false, "enum": ["A", "B", "C", "General", "Day", "Night"], "patterns": ["(?i)\\bshift\\s*[:\\-]?\\s*([ABC]|general|day|night)\\b"]},
        {"name": "unit", "type": "text", "required": false, "fallback": "plant_unit"},
        {"name": "shift_incharge", "type": "person", "required": false, "patterns": ["(?i)\\bshift\\s*(?:in[\\s\\-]?charge|supervisor|engineer)\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"]},
        {"name": "entries", "type": "timestamped_list", "required": true, "patterns": ["(?m)^\\s*(\\d{1,2}[:.]\\d{2})\\s*(?:hrs)?\\s*[-:]?\\s*(.{3,300})$"]},
        {"name": "abnormal_conditions", "type": "list", "required": false, "patterns": ["(?i)\\b(?:abnormal|upset|trip|alarm|leak|deviation|high\\s*vibration|high\\s*temperature)\\b[^.\\n]{0,160}"]},
        {"name": "handover_notes", "type": "text", "required": false, "patterns": ["(?i)\\b(?:handover|hand\\s*over|pending\\s*jobs?)\\s*[:\\-]?\\s*(.{3,400})"]}
      ],
      "validation": [
        {"field": "log_date", "rule": "required", "detail": "A log entry with no date cannot be placed in equipment history."},
        {"field": "entries", "rule": "non_empty", "detail": "Log must contain at least one timestamped entry."},
        {"field": "entries", "rule": "time_parseable", "detail": "Entry timestamps must parse as times of day."}
      ]
    },
    "incident_report": {
      "name": "Incident Report",
      "description": "Report of an unplanned event - injury, loss of containment, fire, near miss - with causes and corrective actions.",
      "classification": {
        "keywords": ["incident report", "near miss", "loss of containment", "injury", "fire", "root cause", "corrective action", "immediate cause", "investigation team", "sequence of events"],
        "filename_hints": ["incident", "nearmiss", "near_miss", "investigation", "accident"],
        "min_score": 2
      },
      "expected_fields": ["incident_id", "incident_date", "incident_time", "location", "unit", "incident_type", "severity", "description", "sequence_of_events", "immediate_cause", "root_cause", "contributing_factors", "injuries", "losses", "corrective_actions", "responsible_person", "target_date", "lessons_learned", "source_page"],
      "extraction_fields": [
        {"name": "incident_id", "type": "reference", "required": false, "patterns": ["(?i)\\bincident\\s*(?:no\\.?|number|id|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9/\\-]{2,25})"]},
        {"name": "incident_date", "type": "date", "required": true, "patterns": ["(?i)\\b(?:incident|event|occurrence)\\s*date\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"], "fallback": "doc_date"},
        {"name": "incident_time", "type": "time", "required": false, "patterns": ["(?i)\\btime\\s*(?:of\\s*incident)?\\s*[:\\-]?\\s*(\\d{1,2}[:.]\\d{2}\\s*(?:hrs|am|pm)?)"]},
        {"name": "incident_type", "type": "enum", "required": false, "enum": ["near miss", "first aid", "lost time injury", "fire", "explosion", "loss of containment", "environmental", "property damage", "process safety event"]},
        {"name": "severity", "type": "enum", "required": false, "enum": ["low", "medium", "high", "critical"]},
        {"name": "description", "type": "text", "required": true, "patterns": ["(?i)\\b(?:description|what\\s*happened|brief\\s*description)\\s*[:\\-]?\\s*(.{10,800})"]},
        {"name": "immediate_cause", "type": "text", "required": false, "patterns": ["(?i)\\bimmediate\\s*cause\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "root_cause", "type": "text", "required": false, "patterns": ["(?i)\\broot\\s*cause\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "corrective_actions", "type": "list", "required": false, "patterns": ["(?i)\\b(?:corrective|preventive|recommended)\\s*actions?\\s*[:\\-]?\\s*(.{3,400})"]},
        {"name": "lessons_learned", "type": "text", "required": false, "patterns": ["(?i)\\blessons?\\s*learn(?:ed|t)\\s*[:\\-]?\\s*(.{3,500})"]},
        {"name": "target_date", "type": "date", "required": false, "patterns": ["(?i)\\b(?:target|due)\\s*date\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"]}
      ],
      "validation": [
        {"field": "incident_date", "rule": "required", "detail": "Incidents must be dated to be usable in trend or lessons-learned analysis."},
        {"field": "description", "rule": "required", "detail": "An incident record must describe what happened."},
        {"field": "root_cause", "rule": "distinct_from", "compare_to": "immediate_cause", "detail": "Flag records where root cause merely restates the immediate cause."},
        {"field": "corrective_actions", "rule": "requires_evidence", "detail": "Actions quoted back to the user must cite the report page they came from."}
      ]
    },
    "safety_report": {
      "name": "Safety Report",

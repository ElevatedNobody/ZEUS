    "calibration_report": {
      "name": "Calibration Report",
      "description": "Record of instrument calibration with as-found/as-left readings, reference standard and traceability.",
      "classification": {
        "keywords": ["calibration", "as found", "as left", "reference standard", "traceability", "span", "zero", "loop test", "accuracy", "tolerance", "calibrated by", "due date"],
        "filename_hints": ["calibration", "cal", "loop_test", "certificate"],
        "min_score": 2
      },
      "expected_fields": ["instrument_tag", "instrument_type", "range", "unit", "calibration_date", "next_due_date", "calibrated_by", "reference_standard", "standard_certificate_no", "as_found_readings", "as_left_readings", "tolerance", "result", "ambient_conditions", "source_page"],
      "extraction_fields": [
        {"name": "instrument_tag", "type": "tag", "required": true, "patterns": ["\\b(?:PI|PT|PC|TI|TT|TC|FI|FT|FC|LI|LT|LC|AI|AT|PG|TG)-?\\d{2,5}[A-Z]?\\b"]},
        {"name": "range", "type": "text", "required": false, "patterns": ["(?i)\\brange\\s*[:\\-]?\\s*([\\-0-9.]+\\s*(?:to|-)\\s*[\\-0-9.]+\\s*[A-Za-z/°]{0,10})"]},
        {"name": "calibration_date", "type": "date", "required": true, "patterns": ["(?i)\\b(?:calibration|calibrated\\s*on)\\s*date?\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"], "fallback": "doc_date"},
        {"name": "next_due_date", "type": "date", "required": false, "patterns": ["(?i)\\b(?:next\\s*due|due\\s*date|valid\\s*(?:up\\s*to|till))\\s*[:\\-]?\\s*([0-9A-Za-z/\\-. ]{6,20})"]},
        {"name": "calibrated_by", "type": "person", "required": false, "patterns": ["(?i)\\bcalibrated\\s*by\\s*[:\\-]?\\s*([A-Z][A-Za-z.]*(?:[ \\t]+[A-Z][A-Za-z.]*){0,3})"], "fallback": "author"},
        {"name": "reference_standard", "type": "text", "required": false, "patterns": ["(?i)\\b(?:reference|master)\\s*(?:standard|instrument)\\s*[:\\-]?\\s*([A-Za-z0-9][A-Za-z0-9 ./\\-]{2,40})"]},
        {"name": "as_found_readings", "type": "table", "required": false, "source": "tables"},
        {"name": "as_left_readings", "type": "table", "required": false, "source": "tables"},
        {"name": "tolerance", "type": "quantity", "required": false, "patterns": ["(?i)\\btolerance\\s*[:\\-]?\\s*([+\\-0-9.% ]{2,15})"]},
        {"name": "result", "type": "enum", "required": false, "enum": ["pass", "fail", "acceptable", "adjusted", "rejected"]}
      ],
      "validation": [
        {"field": "instrument_tag", "rule": "required", "detail": "Calibration must be attributable to one instrument."},
        {"field": "next_due_date", "rule": "date_after", "compare_to": "calibration_date", "detail": "Due date must follow the calibration date."},
        {"field": "as_found_readings", "rule": "within_tolerance_check", "detail": "Compare as-found error against stated tolerance; report the comparison, never silently correct it."}
      ]
    },
    "test_report": {

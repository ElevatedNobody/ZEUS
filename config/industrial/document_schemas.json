        {"name": "existing_safeguards", "type": "list", "required": false, "patterns": ["(?i)\\b(?:safeguard|existing\\s*protection|barrier)s?\\s*[:\\-]?\\s*(.{3,300})"]},
        {"name": "risk_ranking", "type": "text", "required": false, "patterns": ["(?i)\\b(?:risk\\s*(?:rank|rating|level)|sil)\\s*[:\\-]?\\s*([A-Za-z0-9 \\-]{1,20})"]},
        {"name": "recommendations", "type": "list", "required": false, "patterns": ["(?i)\\brecommendations?\\s*[:\\-]?\\s*(.{3,400})"]}

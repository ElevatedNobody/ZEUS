        {"name": "background", "type": "text", "required": false, "patterns": ["(?i)\\b(?:background|context|present\\s*status)\\s*[:\\-]?\\s*(.{3,600})"]},
        {"name": "proposal", "type": "text", "required": true, "patterns": ["(?i)\\b(?:proposal|proposed|it\\s*is\\s*proposed)\\s*[:\\-]?\\s*(.{3,600})"]},
        {"name": "justification", "type": "text", "required": false, "patterns": ["(?i)\\b(?:justification|rationale|reason)\\s*[:\\-]?\\s*(.{3,600})"]},

    "technical_datasheet": {
      "name": "Technical Datasheet",
      "description": "Design and performance data sheet for equipment or an instrument.",
      "classification": {
        "keywords": ["datasheet", "data sheet", "design pressure", "design temperature", "rated capacity", "material of construction", "operating conditions", "nozzle schedule", "performance curve"],
        "filename_hints": ["datasheet", "data_sheet", "ds", "spec", "specification"],
